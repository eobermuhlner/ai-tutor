# .env.example - Template for local development with docker-compose
# Copy this file to .env and fill in your actual values

# AI Provider Configuration (at least one required)
OPENAI_API_KEY=your-openai-api-key-here
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Security Configuration
JWT_SECRET=change-this-to-a-secure-random-key

# PostgreSQL Configuration (required when using PostgreSQL profile)
POSTGRES_PASSWORD=your-secure-postgres-password-here

# User Configuration (optional - defaults provided)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminadmin
DEMO_USERNAME=demo
DEMO_PASSWORD=demo

# Google OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Service Ports (optional - defaults shown)
# Uncomment and modify to use different ports
#BACKEND_PORT=8080
#FRONTEND_PORT=5173
#PROMETHEUS_PORT=9090
#GRAFANA_PORT=3000
#POSTGRES_PORT=5432

# Grafana Configuration (optional)
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=admin
